msgstr " · OUT OF COAL"

#: ui/hud.gd:120
msgid "Kỷ lục mới!"
msgstr "New record!"

#: ui/hud.gd:120
msgid "Kỷ lục: %s"
msgstr "Record: %s"

#: ui/hud.gd:129
msgid "Tiếng ồn: %s"
msgstr "Noise: %s"

#: ui/hud.gd:133
msgid "Nỏ thần — sẵn sàng (G)"
msgstr "Divine Crossbow — ready (G)"

#: ui/hud.gd:133
msgid "Nỏ thần %d%%"
msgstr "Divine Crossbow %d%%"

#: ui/hud.gd:169
msgid "%s — sẵn sàng (R)"
msgstr "%s — ready (R)"

#: ui/hud.gd:169
msgid "%s — %ds"
msgstr "%s — %d s"

#: ui/hud.gd:190
msgid "Giữ E để đỡ đồng đội dậy — %d%%"
msgstr "Hold E to help your teammate up — %d%%"

#: ui/hud.gd:193
msgid "Đang vác %s — click / E để đặt (không tốn tài nguyên)"
msgstr "Carrying %s — click / E to place it (free)"

#: ui/hud.gd:199
msgid "Hết tài nguyên để xây %s — mang thêm về hoặc góp từ túi"
msgstr "Out of resources for %s — bring more back or chip in from your pack"

#: ui/hud.gd:201
msgid "Giữ E để xây %s — %d%%"
msgstr "Hold E to build %s — %d%%"

#: ui/hud.gd:206
msgid "Giữ F để thu %s"
msgstr "Hold F to fold up %s"

#: ui/hud.gd:206
msgid "Giữ F để dỡ bản vẽ %s"
msgstr "Hold F to take down the %s blueprint"

#: ui/hud.gd:214
msgid "Giữ E để sửa pháo đài"
msgstr "Hold E to repair the citadel"

#: ui/hud.gd:216
msgid "Kho hết %s — cần mang về để sửa"
msgstr "No %s in storage — bring some back to repair"

#: ui/hud.gd:229
msgid " · %d người"
msgstr " · %d players"

#: ui/hud.gd:245
msgid "Mang %d/%d"
msgstr "Carrying %d/%d"

#: ui/hud.gd:255
msgid "Pháo đài %s %d/%d"
msgstr "%s citadel %d/%d"

#: ui/hud.gd:264
msgid "Nộp vào kho: %s"
msgstr "Stored: %s"

#: ui/result_screen.gd:21
msgid "Chơi lại"
msgstr "Play again"

#: ui/result_screen.gd:24
msgid "Về menu"
msgstr "Main menu"

#: ui/result_screen.gd:33
msgid "Thành trì đã thất thủ"
msgstr "The citadel has fallen"

#: ui/result_screen.gd:37
msgid "Thử thách ngày %s"
msgstr "Daily challenge %s"

#: ui/result_screen.gd:38
msgid "Quãng đường: %s\nKỷ lục: %s\nThời gian: %d:%02d\nQuái đã hạ: %d"
msgstr "Distance: %s\nRecord: %s\nTime: %d:%02d\nMonsters slain: %d"

#: ui/route_progress.gd:32
msgid "Điểm dừng: %d m"
msgstr "Next stop: %d m"

#: ui/start_menu.gd:76
msgid "Chọn ngôn ngữ"
msgstr "Language"

#: ui/start_menu.gd:80
msgid "THÀNH TRÌ"
msgstr "THÀNH TRÌ"

#: ui/start_menu.gd:81
msgid "Hộ tống thành trì đi càng xa càng tốt"
msgstr "Escort the citadel as far as you can"

#: ui/start_menu.gd:82
msgid "Chơi"
msgstr "Play"

#: ui/start_menu.gd:83
msgid "Thử thách hôm nay (%s)"
msgstr "Today's challenge (%s)"

#: ui/start_menu.gd:84
msgid "Chơi cùng bạn bè"
msgstr "Play with friends"

#: ui/start_menu.gd:85
msgid "Kỷ lục: %s   ·   Hôm nay: %s   ·   Đã chơi %d trận"
msgstr "Record: %s   ·   Today: %s   ·   %d runs played"

#: ui/start_menu.gd:106
msgid "Tạo phòng"
msgstr "Create room"

#: ui/start_menu.gd:107
msgid "Địa chỉ IP của chủ phòng"
msgstr "Host's IP address"

#: ui/start_menu.gd:108
msgid "Vào phòng"
msgstr "Join"

#: ui/start_menu.gd:109
msgid "Bắt đầu"
msgstr "Start"

#: ui/start_menu.gd:110
msgid "Quay lại"
msgstr "Back"

#: ui/start_menu.gd:111
msgid "Tối đa %d người. Cùng mạng LAN, hoặc mở cổng %d."
msgstr "Up to %d players. Same LAN, or forward port %d."

#: ui/start_menu.gd:155
msgid "Chọn vai trò"
msgstr "Choose your role"

#: ui/upgrade_panel.gd:37
msgid "Điểm dừng — nâng cấp"
msgstr "Stop — upgrades"

#: ui/upgrade_panel.gd:38
msgid "Chọn tuyến tiếp theo"
msgstr "Choose the next route"

#: ui/upgrade_panel.gd:56
msgid "Pháo đài"
msgstr "Citadel"

#: ui/upgrade_panel.gd:65
msgid "Vũ khí — chọn 1 thẻ"
msgstr "Weapon — pick 1 card"

#: ui/upgrade_panel.gd:117
msgid "Khởi hành  ▶  (Space)"
msgstr "Set off  ▶  (Space)"

#: ui/upgrade_panel.gd:119
msgid "Đã sẵn sàng — chờ đồng đội (%d/%d)"
msgstr "Ready — waiting for teammates (%d/%d)"

#: ui/upgrade_panel.gd:121
msgid "Sẵn sàng khởi hành  ▶  (Space) — %d/%d"
msgstr "Ready to depart  ▶  (Space) — %d/%d"

#: ui/upgrade_panel.gd:131
msgid "Nâng thân pháo đài lên %s (%d máu) — %s"
msgstr "Rebuild the citadel in %s (%d HP) — %s"

#: ui/upgrade_panel.gd:135
msgid "Thân pháo đài đã ở cấp cao nhất"
msgstr "Citadel body at its highest level"

#: ui/upgrade_panel.gd:144
msgid "%s — cấp tối đa"
msgstr "%s — max level"

#: ui/upgrade_panel.gd:147
msgid "%s cấp %d — %s"
msgstr "%s level %d — %s"

#: classes/types/engineer.tres
msgid "Công binh"
msgstr "Engineer"

#: classes/types/engineer.tres
msgid "Gõ búa và sửa thành nhanh hơn, vác được 2 công trình."
msgstr "Builds and repairs faster, carries 2 structures."

#: classes/types/engineer.tres
msgid "Dựng tốc"
msgstr "Rapid Build"

#: classes/types/engineer.tres
msgid "Các bản vẽ quanh mình xây nhanh gấp 3 trong 5 giây."
msgstr "Nearby blueprints build 3× faster for 5 seconds."

#: classes/types/general.tres
msgid "Võ tướng"
msgstr "General"

#: classes/types/general.tres
msgid "Máu và sát thương cao hơn."
msgstr "More health and damage."

#: classes/types/general.tres
msgid "Hét trận"
msgstr "War Cry"

#: classes/types/general.tres
msgid "Kéo quái quanh mình về phía mình, giảm sát thương phải nhận trong 4 giây."
msgstr "Pulls nearby monsters onto you and reduces damage taken for 4 seconds."

#: classes/types/mechanic.tres
msgid "Thợ máy"
msgstr "Mechanic"

#: classes/types/mechanic.tres
msgid "Tăng tốc tốn ít Than hơn, nâng cấp pháo đài rẻ hơn (cả đội)."
msgstr "Overdrive burns less coal, citadel upgrades cost less (whole team)."

#: classes/types/mechanic.tres
msgid "Đốt lò"
msgstr "Stoke the Boiler"

#: classes/types/mechanic.tres
msgid "Tăng tốc pháo đài 8 giây mà không tốn thêm Than."
msgstr "Overdrives the citadel for 8 seconds at no extra coal."

#: classes/types/shaman.tres
msgid "Thầy pháp"
msgstr "Shaman"

#: classes/types/shaman.tres
msgid "Công trình gần mình bắn nhanh hơn."
msgstr "Nearby structures fire faster."

#: classes/types/shaman.tres
msgid "Bùa trận"
msgstr "Battle Charm"

#: classes/types/shaman.tres
msgid "Vùng hồi máu cho người và công trình; quái trong vùng bị chậm."
msgstr "An area that heals players and structures and slows monsters inside."

#: classes/types/woodcutter.tres
msgid "Tiều phu"
msgstr "Woodcutter"

#: classes/types/woodcutter.tres
msgid "Túi đựng gấp đôi, chạy nhanh khi túi rỗng."
msgstr "Double pack size, runs faster with an empty pack."

#: classes/types/woodcutter.tres
msgid "Bổ mạnh"
msgstr "Heavy Chop"

#: classes/types/woodcutter.tres
msgid "Một nhát lấy 3 đơn vị Gỗ hoặc Than."
msgstr "One strike takes 3 wood or coal."

#: combat/upgrades/arc.tres
msgid "Chém rộng +40°"
msgstr "Wide Slash +40°"

#: combat/upgrades/arc.tres
msgid "Vùng chém hình quạt rộng thêm 40 độ."
msgstr "Your swing covers a 40° wider arc."

#: combat/upgrades/damage.tres
msgid "Sát thương +30%"
msgstr "Damage +30%"

#: combat/upgrades/damage.tres
msgid "Mỗi đòn chém gây thêm 30% sát thương."
msgstr "Every swing deals 30% more damage."

#: combat/upgrades/reach.tres
msgid "Tầm với +25%"
msgstr "Reach +25%"

#: combat/upgrades/reach.tres
msgid "Đòn chém với xa hơn 25%."
msgstr "Your swing reaches 25% farther."

#: combat/upgrades/speed.tres
msgid "Đánh nhanh +20%"
msgstr "Attack Speed +20%"

#: combat/upgrades/speed.tres
msgid "Thời gian giữa hai đòn ngắn hơn 20%."
msgstr "20% less time between swings."

#: fortress/tiers/stone.tres
msgid "Đá"
msgstr "Stone"

#: fortress/tiers/wood.tres
msgid "Gỗ"
msgstr "Wood"

#: fortress/upgrades/boiling_oil.tres
msgid "Dầu sôi"
msgstr "Boiling Oil"

#: fortress/upgrades/boiling_oil.tres
msgid "Mỗi khi thành mất thêm 20% máu, dội dầu sôi quanh thân."
msgstr "Every time the citadel loses another 20% of its health, it pours boiling oil around itself."

#: fortress/upgrades/crossbow.tres
msgid "Nỏ liên châu"
msgstr "Repeating Crossbow"

#: fortress/upgrades/crossbow.tres
msgid "Nỏ trên thành bắn mạnh hơn, nhanh hơn, xa hơn."
msgstr "The crossbow on the citadel hits harder, faster and farther."

#: fortress/upgrades/furnace.tres
msgid "Lò lửa"
msgstr "Fire Furnace"

#: fortress/upgrades/furnace.tres
msgid "Phun lửa vào quái sát thành, mỗi lần đốt 1 Than."
msgstr "Breathes fire on monsters at the walls, burning 1 coal per burst."

#: fortress/upgrades/shield.tres
msgid "Khiên tự hồi"
msgstr "Regenerating Shield"

#: fortress/upgrades/shield.tres
msgid "Khiên hấp thụ sát thương, tự hồi khi không bị đánh."
msgstr "A shield absorbs damage and recovers when not under attack."

#: resources/types/bronze.tres
msgid "Đồng"
msgstr "Bronze"

#: resources/types/coal.tres
msgid "Than"
msgstr "Coal"

#: structures/types/barricade.tres
msgid "Rào gỗ"
msgstr "Wooden Barricade"

#: structures/types/crossbow_turret.tres
msgid "Tháp nỏ"
msgstr "Crossbow Turret"

#: world/routes/coal_mine.tres
msgid "Mỏ than"
msgstr "Coal Mine"

#: world/routes/coal_mine.tres
msgid "Than nằm khắp nơi — nhưng đầy bom ẩn và ít cây."
msgstr "Coal everywhere — but full of hidden bombs and few trees."

#: world/routes/old_forest.tres
msgid "Rừng già"
msgstr "Old Forest"

#: world/routes/old_forest.tres
msgid "Cây cối um tùm — nhiều Gỗ, nhưng quái kéo tới dày hơn và ít than."
msgstr "Dense woods — plenty of wood, but more monsters and little coal."

#: world/routes/plains.tres
msgid "Đồng bằng"
msgstr "Plains"

#: world/routes/plains.tres
msgid "Yên bình, quái thưa — nhưng tài nguyên cũng nghèo."
msgstr "Peaceful and sparse — but poor in resources too."

#: world/routes/ruined_temple.tres
msgid "Đền hoang"
msgstr "Ruined Temple"

#: world/routes/ruined_temple.tres
msgid "Quái ở đây giữ nhiều Đồng — nhưng chúng trâu hơn."
msgstr "Monsters here carry more bronze — but they are tougher."

