#: match/match.gd:166
msgid "Bảo vệ thành trì — đi càng xa càng tốt!"
msgstr "Protect the citadel — go as far as you can!"

#: match/match.gd:241
msgid "Người chơi %d đã vào"
msgstr "Player %d joined"

#: match/match.gd:256
msgid "Một người chơi đã rời đi"
msgstr "A player left"

#: match/match.gd:312
msgid "Bạn đã gục — đồng đội giữ E cạnh bạn để đỡ dậy (%d)"
msgstr "You are down — a teammate can hold E next to you to help you up (%d)"

#: match/match.gd:314
msgid "Hồi sinh sau %d…"
msgstr "Respawning in %d…"

#: match/match.gd:435
msgid "Tăng tốc! Tốn Than gấp nhiều lần"
msgstr "Overdrive! Burns far more coal"

#: match/match.gd:435
msgid "Chạy bình thường"
msgstr "Normal speed"

#: match/match.gd:443
msgid "NỎ THẦN! Trúng %d quái"
msgstr "DIVINE CROSSBOW! %d monsters hit"

#: match/match.gd:450
msgid "TRUY ĐUỔI! Bầy quái dồn tới từ phía sau — chạy tới điểm dừng!"
msgstr "PURSUIT! The horde closes in from behind — reach the next stop!"

#: match/match.gd:554
msgid "Không mở được phòng (cổng %d đang bận?)"
msgstr "Could not open the room (is port %d in use?)"

#: match/match.gd:563
msgid "Địa chỉ không hợp lệ"
msgstr "Invalid address"

#: match/match.gd:567
msgid "Đang kết nối tới %s…"
msgstr "Connecting to %s…"

#: match/match.gd:573
msgid "Đã vào phòng — chờ chủ phòng bắt đầu"
msgstr "In the room — waiting for the host to start"

#: match/match.gd:578
msgid "Không kết nối được tới %s"
msgstr "Could not connect to %s"

#: match/match.gd:617
msgid "Phòng đã mở — địa chỉ: %s"
msgstr "Room open — address: %s"

#: match/match.gd:618
msgid "Người chơi: %d/%d"
msgstr "Players: %d/%d"

#: match/match.gd:706
msgid "Đốt lò! Pháo đài tăng tốc mà không tốn thêm Than"
msgstr "Boiler stoked! The citadel speeds up at no extra coal"

#: match/match.gd:708
msgid "Hét trận! Quái quanh bạn lao vào bạn"
msgstr "War cry! Nearby monsters charge at you"

#: match/match.gd:887
msgid "Pháo đài dẫm phải bom! Đứng cạnh, giữ E để sửa"
msgstr "The citadel hit a bomb! Stand next to it and hold E to repair"

#: match/match.gd:901
msgid "Điểm dừng — nâng cấp rồi khởi hành"
msgstr "Stop — upgrade, then set off"

#: match/match.gd:915
msgid "Khởi hành — tuyến %s"
msgstr "Setting off — %s route"

#: match/match.gd:917
msgid "Khởi hành!"
msgstr "Setting off!"

#: player/warrior.gd:233
msgid "Đỡ dậy %d%%"
msgstr "Reviving %d%%"

#: player/warrior.gd:234
msgid "Gục — %ds"
msgstr "Down — %d s"

